{
  "version": 1,
  "id": "dream-zoom",
  "name": "Dream Zoom",
  "category": "Blur",
  "preview": "beach",
  "poster": 1.0,
  "controls": [
    {"id": "speed", "name": "Speed", "default": 1, "min": 0.25, "max": 3, "unit": "times", "speed": true},
    {"id": "intensity", "name": "Intensity", "default": 1, "min": 0, "max": 2, "unit": "percent", "scale": [[0, "amount"], [1, "amount"]]}
  ],
  "passes": [
    {"block": "zoom_blur", "params": {"amount": {"wave": {"period": 2, "from": 0, "to": 0.15}}}},
    {"block": "glow", "params": {"amount": 0.6, "radius": 0.04, "threshold": 0.55}}
  ]
}
