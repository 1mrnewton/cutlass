    {"block": "scanlines", "params": {"amount": 0.35, "count": 200}},
    {"block": "rgb_split", "params": {"x": 0.006}},
    {"block": "grade", "params": {"brightness": {"jitter": {"rate": 12, "from": -0.08, "to": 0.04, "seed": 125}}}},
