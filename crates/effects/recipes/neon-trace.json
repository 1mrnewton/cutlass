{
  "version": 3,
  "id": "neon-trace",
  "name": "Neon Trace",
  "category": "Glitch",
  "preview": "city",
  "controls": [
    {"id": "speed", "name": "Speed", "default": 1, "min": 0.25, "max": 3, "unit": "times", "speed": true},
    {"id": "photo", "name": "Photo", "default": 0.5, "min": 0, "max": 1, "unit": "percent", "set": [[3, "amount"]]}
  ],
  "passes": [
    { "block": "edges", "params": {"only": 1} },
    { "block": "hue", "params": {"degrees": {"keys": [[0, -180], [3, 180]], "repeat": 3}} },
    { "block": "glow", "params": {"amount": 1.5, "radius": 0.02, "threshold": 0.15} },
    { "block": "blend", "params": {"mode": 0, "amount": 0.5} }
  ]
}
