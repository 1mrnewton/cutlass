{
  "version": 1,
  "id": "retro-glitch",
  "name": "Retro Glitch",
  "category": "Glitch",
  "preview": "beach",
  "controls": [
    {"id": "speed", "name": "Speed", "default": 1, "min": 0.25, "max": 3, "unit": "times", "speed": true},
    {"id": "intensity", "name": "Intensity", "default": 1, "min": 0, "max": 2, "unit": "percent", "scale": [[1, "x"], [2, "amount"]]},
    {"id": "levels", "name": "Levels", "default": 6, "min": 2, "max": 16, "unit": "plain", "set": [[0, "levels"]]}
  ],
  "passes": [
    {"block": "posterize", "params": {"levels": 6}},
    {"block": "rgb_split", "params": {"x": {"jitter": {"rate": 8, "from": -0.02, "to": 0.02, "seed": 134}}}},
    {"block": "slices", "params": {"count": 10, "amount": {"jitter": {"rate": 8, "from": 0, "to": 0.08, "seed": 135}}, "seed": {"jitter": {"rate": 8, "from": 0, "to": 1000, "seed": 136}}}}
  ]
}
